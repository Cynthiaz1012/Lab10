<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.CheckMenuItem?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.RadioMenuItem?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="mainPane" prefHeight="200.0" prefWidth="200.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.lab10.PrimaryController">
   <children>
      <MenuBar layoutX="6.0" layoutY="2.0">
         <menus>
            <Menu text="_File">
               <items>
                  <MenuItem fx:id="newItem" mnemonicParsing="false" onAction="#handleNew" text="New" />
                  <MenuItem fx:id="openItem" mnemonicParsing="false" onAction="#handleOpen" text="Open" />
                  <MenuItem fx:id="closeItem" mnemonicParsing="false" onAction="#handleClose" text="Close" />
                  <MenuItem fx:id="saveItem" mnemonicParsing="false" text="Save As" />
               </items>
            </Menu>
            <Menu mnemonicParsing="false" text="_Edit">
               <items>
                  <CheckMenuItem fx:id="gridItem" mnemonicParsing="false" onAction="#handleGrid" text="Use GridLines " />
                  <MenuItem fx:id="copyItem" mnemonicParsing="false" text="Copy" />
                  <Menu fx:id="searchMenu" mnemonicParsing="false" text="Search">
                     <items>
                        <MenuItem fx:id="findItem" mnemonicParsing="false" text="Find" />
                        <MenuItem fx:id="replaceItem" mnemonicParsing="false" text="Replace" />
                     </items>
                  </Menu>
               </items>
            </Menu>
            <Menu mnemonicParsing="false" text="_Settings">
               <items>
                  <RadioMenuItem fx:id="smallItem" mnemonicParsing="false" onAction="#handleSizeSmall" text="Small" />
                  <RadioMenuItem fx:id="mediumItem" mnemonicParsing="false" text="Medium" />
                  <RadioMenuItem fx:id="largeItem" mnemonicParsing="false" text="Large " />
               </items>
            </Menu>
         </menus>
      </MenuBar>
   </children>
</AnchorPane>
